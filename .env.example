# FortyGuard Data Access
FORTYGUARD_API_KEY=your_fortyguard_key_here

# NVIDIA NIM (Agent)
NVIDIA_NIM_API_KEY=nvapi-your_nim_key_here
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Triton Inference Server
TRITON_SERVER_URL=localhost:8001

# PostgreSQL + PostGIS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shade_db
POSTGRES_USER=shade_user
POSTGRES_PASSWORD=shade_secret

# Frontend / Mapping
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# App Configuration
DEMO_MODE=true
MARYVALE_BBOX=-112.25,33.45,-112.10,33.52
LOG_LEVEL=INFO
