# FortyGuard API Access (Get free trial key at dashboard.fortyguard.com)
FORTYGUARD_API_KEY=your_fortyguard_api_key_here

# Google Gemini API Key (For Autonomous Co-Pilot)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# NVIDIA NIM (Alternative LLM Backend)
NVIDIA_NIM_API_KEY=your_nvidia_nim_key_here
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Triton Inference Server
TRITON_SERVER_URL=localhost:8001

# PostgreSQL + PostGIS Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shade_db
POSTGRES_USER=shade_user
POSTGRES_PASSWORD=shade_secret

# Frontend / Mapping (Mapbox GL)
MAPBOX_ACCESS_TOKEN=Your Mapbox Public Token

# Application Mode
DEMO_MODE=true
MARYVALE_BBOX=-112.25,33.45,-112.10,33.52
LOG_LEVEL=INFO
