# ── SHADE environment configuration (copy to .env and fill in) ────────────────
# None of these are required for the core backend to boot — every integration
# degrades to a clearly-labeled modeled fallback when its key is absent.

# FortyGuard production API (hackathon spec). When absent, SHADE uses the
# deterministic physics-modeled baseline and marks responses is_synthetic=true.
FORTYGUARD_API_KEY=

# LLM for the agent (either one). Without a key the agent returns the
# deterministic pipeline narrative computed from real tool outputs.
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=

# Mapbox (frontend base map). Without it the map shows a notice; data features work.
# Create a free token at https://account.mapbox.com/  — do NOT commit the real token.
MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN=

# Optional infrastructure (docker-compose --profile full)

# Set to "false" to disable demo-mode defaults
DEMO_MODE=false
